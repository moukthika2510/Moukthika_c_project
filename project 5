#include <stdio.h>


void main()
{
    FILE *fp;
    char name[300];

    //clrscr();

    // 1. Writing data into file
    fp = fopen("student.txt", "w");

    if (fp == NULL)
    {
        printf("File cannot be opened");
    
        return;
    }

    fprintf(fp, "before the c class i dont know anything about c");

    fclose(fp);

    printf("Data written successfully\n");


    // 2. Appending data into file
    fp = fopen("moukthika.txt", "a");

    if (fp == NULL)
    {
        printf("File cannot be opened");
        
        return;
    }

    fprintf(fp, "after c class its easy to understand the c program");

    fclose(fp);

    printf("Data appended successfully\n");


    // 3. Reading data from file
    fp = fopen("student.txt", "r");

    if (fp == NULL)
    {
        printf("File cannot be opened");
        
        return;
    }

    printf("\nFile Contents:\n");

    while (fgets(name, sizeof(name), fp) != NULL)
    {
        printf("%s", name);
    }

    fclose(fp);


}